---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import nextpointImage from '../../assets/images/pockey6.png';
import nextpointTranscriptsImage from '../../assets/images/pockey7.png';

const highlights = [
    { label: 'Client', value: 'Personal project / Interview assignment' },
    { label: 'Completed', value: '2022' },
    { label: 'Role', value: 'UI Designer' },
];

const outcomes = [
	'Created an engaging interface tailored specifically for children aged eight to twelve.',
    'Simplified financial concepts through visual progress indicators and educational content.',
    'Established a complete design system, including colours, typography, icons, and reusable components.',
    'Combined goal tracking, transaction history, rewards, and learning resources within a single experience.',
    'Delivered an interactive prototype that balances education with playful interaction.',
];

const caseStudyUrl = new URL('/work/pockeyapp', siteConfig.siteUrl).toString();
const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: siteConfig.siteUrl,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Work',
				item: new URL('/work', siteConfig.siteUrl).toString(),
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: 'POCKEYAPP Case Study',
				item: caseStudyUrl,
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: 'POCKEYAPP Case Study',
		headline: 'case study for pockey app',
		description:
			'',
		url: caseStudyUrl,
		author: {
			'@type': 'Person',
			name: siteConfig.authorName,
		},
		isPartOf: {
			'@type': 'WebSite',
			name: siteConfig.name,
			url: siteConfig.siteUrl,
		},
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title="Nextpoint Case Study | Astro Theme for UI/UX Designer Portfolios"
	description="Sample Nextpoint case study from the Maria Astro theme for UI/UX designer portfolios, built to showcase product design decisions and visual storytelling."
	ogType="article"
	ogImageAlt="Preview of the Nextpoint sample case study page in the Maria Astro theme"
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content">
			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Case Study</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>POCKEYAPP</span>
				</p>
				<h1 class="display-title">Designing a money management app that makes saving engaging, educational, and rewarding for children.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						Pockey is a mobile application designed to help children learn the fundamentals of saving, budgeting, and delayed gratification through playful interactions, visual progress tracking, and educational content.
					</p>
				</div>
			</section>

			<section class="meta-strip" id="overview">
				{highlights.map((item) => (
					<div class="meta-item">
						<p class="meta-label">{item.label}</p>
						<p class="meta-value">{item.value}</p>
					</div>
				))}
			</section>

			<section class="lead-image-section">
				<Image
					class="lead-image"
					src={nextpointImage}
					alt="Nextpoint dashboard showing transcript metrics, AI summary, and recent transcript activity"
					decoding="async"
					widths={[720, 1080, 1440]}
					sizes="(max-width: 78rem) 100vw, 78rem"
				/>
			</section>

			<section class="summary-section">
				<p class="section-kicker">Overview</p>
				<h2>A mobile experience that helps children develop healthy financial habits through goals, rewards, and interactive learning.</h2>
				<div class="summary-main">
					<p>
						The original objective was to create an engaging interface that could introduce financial literacy to children between the ages of eight and twelve. Rather than overwhelming users with numbers and transactions, the experience focuses on visual feedback, simple navigation, and a rewarding savings journey.
					</p>
					<p>
						My role was centred primarily on the visual design process, including interface design, colour selection, typography, iconography, component creation, and overall design consistency.
					</p>
					<p class="summary-meta">
						<strong>Focus:</strong> Gamification, visual hierarchy, accessibility, and engagement.
					</p>
					<p class="summary-meta">
						<strong>Scope:</strong> UI design, wireframing, design system creation, and interaction design.
					</p>
				</div>
			</section>

			<section class="editorial-section editorial-section-no-divider" id="process">
				<div class="section-rail">
					<p class="section-kicker">What I Did</p>
				</div>
				<div class="story-block">
					<p>
						I began by defining the application's information architecture and mapping the primary user journey, from creating a savings goal to tracking progress and earning rewards.
					</p>
					<p>
						Once the structure was established, I explored visual directions that would resonate with younger users while remaining intuitive and easy to understand. The process included creating wireframes, developing reusable components, establishing typography and colour systems, and refining every screen to support a clear and playful experience.
					</p>
					<p>
						Special attention was given to educational elements, notifications, rewards, and progress indicators to maintain long-term engagement and encourage positive saving behaviour.
					</p>
				</div>
			</section>

			<section class="supporting-image-section">
				<Image
					class="supporting-image"
					src={nextpointTranscriptsImage}
					alt="Nextpoint transcripts view showing transcript summaries and related actions"
					loading="lazy"
					decoding="async"
					widths={[720, 1080, 1440]}
					sizes="(max-width: 78rem) 100vw, 78rem"
				/>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Design Decisions</p>
				</div>
				<div class="story-block">
					<p>
						Financial applications can quickly become overly complex, especially for younger audiences. Because of this, simplicity became the foundation of the interface.
					</p>
					<p>
						The overall visual language combines vibrant colours, rounded shapes, friendly illustrations, and clear typography to create an environment that feels approachable and enjoyable. Important information, such as balances, goals, deadlines, and recent activities, is surfaced immediately so children can understand their progress at a glance.
					</p>
					<p>
						Gamified elements, including achievements, rewards, notifications, and educational prompts, were introduced to reinforce learning while maintaining motivation over time.
					</p>
				</div>
			</section>

			<section class="editorial-section" id="outcome">
				<div class="section-rail">
					<p class="section-kicker">Outcome</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{outcomes.map((item) => <li>{item}</li>)}
					</ul>
					<p class="closing-text">
						This project demonstrates how thoughtful visual design can transform complex concepts into experiences that feel approachable, motivating, and memorable.
					</p>
				</div>
			</section>
		<div class="text-center mt-16">
    <a
        href="https://cdn.jsdelivr.net/gh/anandpnr123-ai/portfolio_anand@22c86c986ded6779128ee2791a0dcfc0c95e7509/public/pdf/pockeyapp.pdf"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-block bg-black !text-white font-semibold px-8 py-4 rounded-full hover:opacity-80 transition"
	>
        View full case study →
    </a>
</div>
		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text,
	.hero-note,
	.summary-main p,
	.summary-meta,
	.story-block p,
	.outcome-list li,
	.closing-text {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-text,
	.hero-note,
	.summary-main p,
	.summary-meta,
	.story-block p,
	.closing-text {
		margin: 0;
	}

	.hero-note,
	.closing-text {
		color: var(--muted-foreground);
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.supporting-image-section {
		padding: 2rem 0 4rem;
		border-bottom: 1px solid var(--border);
	}

	.supporting-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.summary-section {
		padding: 0 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	.summary-section h2 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 3vw, 3rem);
		line-height: 1.04;
	}

	.summary-main {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.summary-side p {
		color: var(--muted-foreground);
	}

	.summary-side strong {
		color: var(--foreground);
	}

	.summary-meta {
		color: var(--muted-foreground);
	}

	.summary-meta strong {
		color: var(--foreground);
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	#outcome {
		border-bottom: 0;
	}

	.editorial-section-no-divider {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
		margin-top: 0;
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	.closing-text {
		margin-top: 1.5rem;
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text,
		.hero-note,
		.summary-main p,
		.summary-meta,
		.story-block p,
		.outcome-list li,
		.closing-text {
			font-size: 1.05rem;
		}
	}
</style>
