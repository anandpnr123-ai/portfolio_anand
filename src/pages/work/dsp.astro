---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import nextpointImage from '../../assets/images/nextpoint.webp';
import nextpointTranscriptsImage from '../../assets/images/nextpoint-transcripts.webp';

const highlights = [
    { label: 'Client', value: 'Concept project' },
    { label: 'Completed', value: '2026 (Work in progress)' },
    { label: 'Role', value: 'UX/UI Designer' },
];

const outcomes = [
	'Simplified campaign creation for first-time advertisers and smaller teams.',
    'Combined campaign management, reporting, analytics, and optimisation within a single platform.',
    'Introduced AI-assisted recommendations to make performance insights easier to understand.',
    'Created clearer workflows for campaign creation, monitoring, and creative management.',
    'Designed an experience that balances the needs of both experienced marketers and independent developers.',
];

const caseStudyUrl = new URL('/work/dsp', siteConfig.siteUrl).toString();
const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: siteConfig.siteUrl,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Work',
				item: new URL('/work', siteConfig.siteUrl).toString(),
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: 'DSP Case Study',
				item: caseStudyUrl,
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: 'DSP Case Study',
		headline: 'case study for DSP',
		description:
			'',
		url: caseStudyUrl,
		author: {
			'@type': 'Person',
			name: siteConfig.authorName,
		},
		isPartOf: {
			'@type': 'WebSite',
			name: siteConfig.name,
			url: siteConfig.siteUrl,
		},
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title="Nextpoint Case Study | Astro Theme for UI/UX Designer Portfolios"
	description="Sample Nextpoint case study from the Maria Astro theme for UI/UX designer portfolios, built to showcase product design decisions and visual storytelling."
	ogType="article"
	ogImageAlt="Preview of the Nextpoint sample case study page in the Maria Astro theme"
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content">
			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Case Study</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>DSP</span>
				</p>
				<h1 class="display-title">Designing an AI-powered advertising platform that makes campaign management feel simpler and more intuitive.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						This project explores how AI can help indie game developers and marketers create, launch, and optimize advertising campaigns without feeling overwhelmed by technical complexity. The goal was to transform traditional DSP workflows into an experience that feels more approachable, intuitive, and easier to understand.
					</p>
				</div>
			</section>

			<section class="meta-strip" id="overview">
				{highlights.map((item) => (
					<div class="meta-item">
						<p class="meta-label">{item.label}</p>
						<p class="meta-value">{item.value}</p>
					</div>
				))}
			</section>

			<section class="lead-image-section">
				<Image
					class="lead-image"
					src={nextpointImage}
					alt="Nextpoint dashboard showing transcript metrics, AI summary, and recent transcript activity"
					decoding="async"
					widths={[720, 1080, 1440]}
					sizes="(max-width: 78rem) 100vw, 78rem"
				/>
			</section>

			<section class="summary-section">
				<p class="section-kicker">Overview</p>
				<h2>A self-serve advertising platform built for teams managing campaigns, creatives, and performance insights.</h2>
				<div class="summary-main">
					<p>
						Most advertising platforms give users access to enormous amounts of data, but very little guidance on what that information actually means. For smaller studios and independent developers, this often turns campaign management into a frustrating and time-consuming process.

This project explores how thoughtful UX design and AI-assisted experiences can reduce complexity, increase confidence, and help users make better decisions faster.
					</p>
					<p>
						My role was to research the industry, understand user behaviour, identify opportunities, and design an experience that balances simplicity with flexibility.
					</p>
					<p class="summary-meta">
						<strong>Focus:</strong> User research, AI-assisted workflows, dashboard clarity, and campaign management.
					</p>
					<p class="summary-meta">
						<strong>Scope:</strong> UX research, interaction design, wireframing, information architecture, and interface design..
					</p>
				</div>
			</section>

			<section class="editorial-section editorial-section-no-divider" id="process">
				<div class="section-rail">
					<p class="section-kicker">What I Did</p>
				</div>
				<div class="story-block">
					<p>
						I started by learning how the mobile advertising ecosystem works and studying the relationship between developers, marketers, publishers, and demand-side platforms.

From there, I conducted interviews, distributed surveys, explored community discussions, analysed existing products, and mapped the complete user journey.
					</p>
					<p>
						The insights gathered throughout the research phase helped shape the information architecture, campaign workflows, dashboard experience, and AI-driven recommendation system.
					</p>
					<p>
						The final result was a platform designed to help users spend less time navigating complexity and more time making informed decisions.
					</p>
				</div>
			</section>

			<section class="supporting-image-section">
				<Image
					class="supporting-image"
					src={nextpointTranscriptsImage}
					alt="Nextpoint transcripts view showing transcript summaries and related actions"
					loading="lazy"
					decoding="async"
					widths={[720, 1080, 1440]}
					sizes="(max-width: 78rem) 100vw, 78rem"
				/>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Design Decisions</p>
				</div>
				<div class="story-block">
					<p>
						Advertising platforms become complicated very quickly. Users are often expected to understand unfamiliar terminology, interpret large amounts of data, and make important decisions with very little guidance. Instead of presenting more charts, tables, and filters, I focused on making the experience feel clearer and more supportive.
					</p>
					<p>
						AI-generated recommendations, guided campaign creation flows, simplified performance summaries, and contextual insights became the foundation of the experience.
					</p>
					<p>
						The goal was not to remove control from users but to provide enough guidance to help them act with greater confidence.
					</p>
				</div>
			</section>

			<section class="editorial-section" id="outcome">
				<div class="section-rail">
					<p class="section-kicker">Outcome</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{outcomes.map((item) => <li>{item}</li>)}
					</ul>
					<p class="closing-text">
						Although the project is still evolving, the foundations have been established to create a more approachable and human-centred advertising platform.
					</p>
				</div>
			</section>
		<div class="text-center mt-16"><a
            
                href="https://www.figma.com/proto/cpH1SskQupsOjVmC5J2kv1/Final-Project?node-id=11743-7456"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-white !text-black font-semibold px-8 py-4 rounded-full hover:opacity-80 transition"
            >
                View Full Case Study on Figma →
            </a>
        </div>
		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text,
	.hero-note,
	.summary-main p,
	.summary-meta,
	.story-block p,
	.outcome-list li,
	.closing-text {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-text,
	.hero-note,
	.summary-main p,
	.summary-meta,
	.story-block p,
	.closing-text {
		margin: 0;
	}

	.hero-note,
	.closing-text {
		color: var(--muted-foreground);
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.supporting-image-section {
		padding: 2rem 0 4rem;
		border-bottom: 1px solid var(--border);
	}

	.supporting-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.summary-section {
		padding: 0 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	.summary-section h2 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 3vw, 3rem);
		line-height: 1.04;
	}

	.summary-main {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.summary-side p {
		color: var(--muted-foreground);
	}

	.summary-side strong {
		color: var(--foreground);
	}

	.summary-meta {
		color: var(--muted-foreground);
	}

	.summary-meta strong {
		color: var(--foreground);
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	#outcome {
		border-bottom: 0;
	}

	.editorial-section-no-divider {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
		margin-top: 0;
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	.closing-text {
		margin-top: 1.5rem;
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text,
		.hero-note,
		.summary-main p,
		.summary-meta,
		.story-block p,
		.outcome-list li,
		.closing-text {
			font-size: 1.05rem;
		}
	}
</style>
