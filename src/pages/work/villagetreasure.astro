---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import nextpointImage from '../../assets/images/villagetreasure5.png';
import nextpointTranscriptsImage from '../../assets/images/villagetreasure4.png';

const highlights = [
    { label: 'Client', value: 'Class assignment' },
    { label: 'Completed', value: '2026' },
    { label: 'Role', value: 'Game Designer · UX/UI Designer' },
];

const outcomes = [
	'Created a complete gameplay concept built around exploration and discovery.',
    'Designed a clear progression system based on clues, rewards, and achievements.',
    'Established a consistent visual style across environments, characters, and interface elements.',
    'Developed onboarding experiences, tutorials, and accessibility-focused interactions.',
    'Combined storytelling, sound design, animations, and gameplay mechanics into a cohesive experience.',
];

const caseStudyUrl = new URL('/work/villagetreasure', siteConfig.siteUrl).toString();
const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: siteConfig.siteUrl,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Work',
				item: new URL('/work', siteConfig.siteUrl).toString(),
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: 'village treasure Case Study',
				item: caseStudyUrl,
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: 'village treasure Case Study',
		headline: 'case study for village treasure game',
		description:
			'',
		url: caseStudyUrl,
		author: {
			'@type': 'Person',
			name: siteConfig.authorName,
		},
		isPartOf: {
			'@type': 'WebSite',
			name: siteConfig.name,
			url: siteConfig.siteUrl,
		},
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title="Nextpoint Case Study | Astro Theme for UI/UX Designer Portfolios"
	description="Sample Nextpoint case study from the Maria Astro theme for UI/UX designer portfolios, built to showcase product design decisions and visual storytelling."
	ogType="article"
	ogImageAlt="Preview of the Nextpoint sample case study page in the Maria Astro theme"
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content">
			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Case Study</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>village treasure</span>
				</p>
				<h1 class="display-title">Designing a mobile adventure game that transforms exploration into a playful treasure-hunting experience.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						Village Treasure is a casual mobile game that combines exploration, storytelling, and simple puzzle mechanics to create a relaxing and rewarding experience for players of all ages. Players travel across different landscapes, uncover hidden clues, and recover treasures that were stolen from their village long ago.
					</p>
				</div>
			</section>

			<section class="meta-strip" id="overview">
				{highlights.map((item) => (
					<div class="meta-item">
						<p class="meta-label">{item.label}</p>
						<p class="meta-value">{item.value}</p>
					</div>
				))}
			</section>

			<section class="lead-image-section">
				<Image
					class="lead-image"
					src={nextpointImage}
					alt="Nextpoint dashboard showing transcript metrics, AI summary, and recent transcript activity"
					decoding="async"
					widths={[720, 1080, 1440]}
					sizes="(max-width: 78rem) 100vw, 78rem"
				/>
			</section>

			<section class="summary-section">
				<p class="section-kicker">Overview</p>
				<h2>A light-hearted adventure designed around discovery, exploration, and storytelling.</h2>
				<div class="summary-main">
					<p>
						The goal of the project was to create an experience that felt easy to understand, visually engaging, and rewarding enough to encourage players to continue exploring.

Rather than focusing on fast-paced action or complicated mechanics, the game centres around curiosity, observation, and gradual progression. Every level introduces a new environment, encouraging players to search for clues and uncover hidden treasures.
					</p>
					<p>
						My role included designing the core gameplay loop, defining the user experience, creating the interface, and establishing the overall visual direction of the game.
					</p>
					<p class="summary-meta">
						<strong>Focus:</strong> Exploration, accessibility, progression systems, and visual storytelling.
					</p>
					<p class="summary-meta">
						<strong>Scope:</strong> Game design, UX design, UI design, wireframing, interaction design, and art direction.
					</p>
				</div>
			</section>

			<section class="editorial-section editorial-section-no-divider" id="process">
				<div class="section-rail">
					<p class="section-kicker">What I Did</p>
				</div>
				<div class="story-block">
					<p>
						I began by defining the story, gameplay loop, target audience, and progression system. From there, I designed the player journey, mapped the game flow, and established the overall structure of each level.
					</p>
					<p>
						The next step involved creating wireframes, designing user interfaces, exploring environmental concepts, and building a visual language that balanced simplicity with immersion.
					</p>
					<p>
						Animations, sound effects, tutorials, rewards, and hint systems were carefully considered to ensure that every interaction contributed to the overall experience.
					</p>
				</div>
			</section>

			<section class="supporting-image-section">
				<Image
					class="supporting-image"
					src={nextpointTranscriptsImage}
					alt="Nextpoint transcripts view showing transcript summaries and related actions"
					loading="lazy"
					decoding="async"
					widths={[720, 1080, 1440]}
					sizes="(max-width: 78rem) 100vw, 78rem"
				/>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Design Decisions</p>
				</div>
				<div class="story-block">
					<p>
						Casual games should feel welcoming from the very first interaction. Because of this, I focused on creating an experience that was easy to learn while remaining engaging over time.
					</p>
					<p>
						The interface was intentionally kept minimal so that the environment itself became the centre of attention. Bright colours, playful characters, subtle animations, and clear visual feedback were introduced to reinforce exploration and maintain a sense of progress.
					</p>
					<p>
						Hints, rewards, and environmental storytelling were used to guide players naturally instead of relying on complicated instructions.
					</p>
				</div>
			</section>

			<section class="editorial-section" id="outcome">
				<div class="section-rail">
					<p class="section-kicker">Outcome</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{outcomes.map((item) => <li>{item}</li>)}
					</ul>
					<p class="closing-text">
						This project became an opportunity to explore how small interactions and thoughtful design choices can transform a simple idea into a memorable experience.
					</p>
				</div>
			</section>
		<div class="text-center mt-16">
    <a
        href="/pdf/villagetreasure.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-black !text-white font-semibold px-8 py-4 rounded-full hover:opacity-80 transition"
    >
        View full case study →
    </a>
</div>
		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text,
	.hero-note,
	.summary-main p,
	.summary-meta,
	.story-block p,
	.outcome-list li,
	.closing-text {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-text,
	.hero-note,
	.summary-main p,
	.summary-meta,
	.story-block p,
	.closing-text {
		margin: 0;
	}

	.hero-note,
	.closing-text {
		color: var(--muted-foreground);
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.supporting-image-section {
		padding: 2rem 0 4rem;
		border-bottom: 1px solid var(--border);
	}

	.supporting-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.summary-section {
		padding: 0 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	.summary-section h2 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 3vw, 3rem);
		line-height: 1.04;
	}

	.summary-main {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.summary-side p {
		color: var(--muted-foreground);
	}

	.summary-side strong {
		color: var(--foreground);
	}

	.summary-meta {
		color: var(--muted-foreground);
	}

	.summary-meta strong {
		color: var(--foreground);
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	#outcome {
		border-bottom: 0;
	}

	.editorial-section-no-divider {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
		margin-top: 0;
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	.closing-text {
		margin-top: 1.5rem;
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text,
		.hero-note,
		.summary-main p,
		.summary-meta,
		.story-block p,
		.outcome-list li,
		.closing-text {
			font-size: 1.05rem;
		}
	}
</style>
