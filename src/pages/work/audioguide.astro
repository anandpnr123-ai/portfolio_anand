---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';
import nextpointImage from '../../assets/images/audioguide5.png';
import nextpointTranscriptsImage from '../../assets/images/audioguide8.png';

const highlights = [
    { label: 'Client', value: 'Academic research project' },
    { label: 'Completed', value: '2026' },
    { label: 'Role', value: 'UX Researcher · UX/UI Designer' },
];

const outcomes = [
	'Identified the major limitations of existing museum audio guides through research and observation.',
    'Designed a context-aware system that delivers audio content automatically based on location.',
    'Created a seamless and hands-free visitor experience supported by mobile devices and BLE technology.',
    'Combined personalisation, accessibility, storytelling, and navigation into a unified experience.',
    'Established a scalable framework that can be adapted to different museum environments.',
];

const caseStudyUrl = new URL('/work/audioguide', siteConfig.siteUrl).toString();
const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: siteConfig.siteUrl,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Work',
				item: new URL('/work', siteConfig.siteUrl).toString(),
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: 'Audio guide Case Study',
				item: caseStudyUrl,
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: 'Audio guide Case Study',
		headline: 'case study for Audio guide',
		description:
			'',
		url: caseStudyUrl,
		author: {
			'@type': 'Person',
			name: siteConfig.authorName,
		},
		isPartOf: {
			'@type': 'WebSite',
			name: siteConfig.name,
			url: siteConfig.siteUrl,
		},
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title="Nextpoint Case Study | Astro Theme for UI/UX Designer Portfolios"
	description="Sample Nextpoint case study from the Maria Astro theme for UI/UX designer portfolios, built to showcase product design decisions and visual storytelling."
	ogType="article"
	ogImageAlt="Preview of the Nextpoint sample case study page in the Maria Astro theme"
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content">
			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Case Study</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>Audio guide</span>
				</p>
				<h1 class="display-title">Designing a context-aware museum guide that makes cultural experiences more immersive, personal, and effortless.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						This project explores how contextual technologies can transform traditional museum audio guides into adaptive experiences that respond to a visitor's location, movement, interests, and behaviour in real time. Instead of forcing visitors to search for information manually, the experience allows stories and insights to appear naturally as they move through the museum.
					</p>
				</div>
			</section>

			<section class="meta-strip" id="overview">
				{highlights.map((item) => (
					<div class="meta-item">
						<p class="meta-label">{item.label}</p>
						<p class="meta-value">{item.value}</p>
					</div>
				))}
			</section>

			<section class="lead-image-section">
				<Image
					class="lead-image"
					src={nextpointImage}
					alt="Nextpoint dashboard showing transcript metrics, AI summary, and recent transcript activity"
					decoding="async"
					widths={[720, 1080, 1440]}
					sizes="(max-width: 78rem) 100vw, 78rem"
				/>
			</section>

			<section class="summary-section">
				<p class="section-kicker">Overview</p>
				<h2>A mobile experience designed to deliver the right story at the right place and time.</h2>
				<div class="summary-main">
					<p>
						Museums have long relied on audio guides to help visitors discover exhibits and learn more about the stories behind them. However, most existing solutions still depend heavily on manual interactions, including entering exhibit numbers, scanning codes, and navigating lengthy menus.

The goal of this project was to explore how context-aware technology could create a more seamless experience by automatically adapting content to each visitor's surroundings and behaviour.
					</p>
					<p>
						My role included conducting research, analysing existing solutions, developing the conceptual framework, and designing an adaptive mobile experience centred around accessibility, storytelling, and exploration.
					</p>
					<p class="summary-meta">
						<strong>Focus:</strong> Context-aware experiences, accessibility, personalisation, and location-based interactions.
					</p>
					<p class="summary-meta">
						<strong>Scope:</strong> User research, competitive analysis, information architecture, interaction design, prototyping, and interface design.
					</p>
				</div>
			</section>

			<section class="editorial-section editorial-section-no-divider" id="process">
				<div class="section-rail">
					<p class="section-kicker">What I Did</p>
				</div>
				<div class="story-block">
					<p>
						I started by exploring the museum experience from both the visitor's and the institution's perspective. The process involved literature reviews, observations, interviews, competitive analysis, and thematic analysis.
					</p>
					<p>
						Through this research, I identified several recurring challenges, including information overload, navigation difficulties, interrupted exploration, and the limitations of traditional audio guides.
					</p>
					<p>
						These insights became the foundation for a mobile application that combines smartphone technology with Bluetooth Low Energy (BLE) beacons to deliver exhibit information automatically and more naturally.
					</p>
				</div>
			</section>

			<section class="supporting-image-section">
				<Image
					class="supporting-image"
					src={nextpointTranscriptsImage}
					alt="Nextpoint transcripts view showing transcript summaries and related actions"
					loading="lazy"
					decoding="async"
					widths={[720, 1080, 1440]}
					sizes="(max-width: 78rem) 100vw, 78rem"
				/>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Design Decisions</p>
				</div>
				<div class="story-block">
					<p>
						Museum visits should feel immersive, not transactional. Existing solutions often require visitors to constantly interact with screens, shifting their attention away from the exhibits themselves.

Instead of increasing the number of interactions, I focused on reducing them.
					</p>
					<p>
						The proposed system continuously detects a visitor's location and delivers relevant information at the right moment while allowing visitors to explore freely at their own pace. A lightweight layer of personalisation was also introduced to adapt recommendations according to individual interests and behaviours.
					</p>
					<p>
						The objective was to make technology feel almost invisible while preserving the human experience at the centre of the journey.
					</p>
				</div>
			</section>

			<section class="editorial-section" id="outcome">
				<div class="section-rail">
					<p class="section-kicker">Outcome</p>
				</div>
				<div class="story-block">
					<ul class="outcome-list">
						{outcomes.map((item) => <li>{item}</li>)}
					</ul>
					<p class="closing-text">
						This project allowed me to explore the intersection of research, technology, and human-centred design while demonstrating how digital experiences can become more responsive to the people using them.
					</p>
				</div>
			</section>
		<div class="text-center mt-16">
    <a
        href="/pdf/Villagetreasure.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-black !text-white font-semibold px-8 py-4 rounded-full hover:opacity-80 transition"
    >
        View full case study →
    </a>
</div>
		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label,
	.section-kicker {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text,
	.hero-note,
	.summary-main p,
	.summary-meta,
	.story-block p,
	.outcome-list li,
	.closing-text {
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.hero-text,
	.hero-note,
	.summary-main p,
	.summary-meta,
	.story-block p,
	.closing-text {
		margin: 0;
	}

	.hero-note,
	.closing-text {
		color: var(--muted-foreground);
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.supporting-image-section {
		padding: 2rem 0 4rem;
		border-bottom: 1px solid var(--border);
	}

	.supporting-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.summary-section {
		padding: 0 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	.summary-section h2 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 3vw, 3rem);
		line-height: 1.04;
	}

	.summary-main {
		display: grid;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.summary-side p {
		color: var(--muted-foreground);
	}

	.summary-side strong {
		color: var(--foreground);
	}

	.summary-meta {
		color: var(--muted-foreground);
	}

	.summary-meta strong {
		color: var(--foreground);
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	#outcome {
		border-bottom: 0;
	}

	.editorial-section-no-divider {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
		margin-top: 0;
	}

	.outcome-list {
		margin: 0;
		padding-left: 1.25rem;
		list-style: disc;
	}

	.outcome-list li::marker {
		color: var(--foreground);
	}

	.closing-text {
		margin-top: 1.5rem;
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text,
		.hero-note,
		.summary-main p,
		.summary-meta,
		.story-block p,
		.outcome-list li,
		.closing-text {
			font-size: 1.05rem;
		}
	}
</style>
